{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "templateParts": [
    {
      "area": "header",
      "name": "header",
      "title": "Header"
    }
  ],
  "settings": {
    "layout": {
      "contentSize": "44rem",
      "wideSize": "80rem"
    },
    "spacing": {
      "blockGap": true,
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "margin": true,
      "padding": true,
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      },
      "units": [
        "rem",
        "%"
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Google Sans\", system-ui, sans-serif",
          "name": "Primary",
          "slug": "primary",
          "fontFace": [
            {
              "fontDisplay": "swap",
              "fontFamily": "Google Sans",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "src": [
                "file:./assets/fonts/google-sans/GoogleSans-Tamil-Variable.woff2"
              ],
              "unicodeRange": "U+0964-0965, U+0B82-0BFA, U+200C-200D, U+20B9, U+25CC"
            },
            {
              "fontDisplay": "swap",
              "fontFamily": "Google Sans",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "src": [
                "file:./assets/fonts/google-sans/GoogleSans-Latin-Variable.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "fluid": false,
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "fluid": {
            "min": "1.0625rem",
            "max": "1.125rem"
          },
          "name": "Medium",
          "size": "1.125rem",
          "slug": "medium"
        },
        {
          "fluid": {
            "min": "1.25rem",
            "max": "1.5rem"
          },
          "name": "Large",
          "size": "1.5rem",
          "slug": "large"
        },
        {
          "fluid": {
            "min": "1.75rem",
            "max": "2.25rem"
          },
          "name": "Extra Large",
          "size": "2.25rem",
          "slug": "x-large"
        },
        {
          "fluid": {
            "min": "2.25rem",
            "max": "3.25rem"
          },
          "name": "Extra Extra Large",
          "size": "3.25rem",
          "slug": "xx-large"
        }
      ],
      "fontStyle": false,
      "fontWeight": true,
      "letterSpacing": false,
      "lineHeight": false,
      "textColumns": false,
      "textTransform": false,
      "writingMode": false
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "var:preset|font-family|primary",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.8"
    },
    "elements": {
      "caption": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.5"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|primary",
          "fontWeight": "700",
          "lineHeight": "1.35"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|large"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      }
    },
    "blocks": {
      "core/post-content": {
        "css": "& pre { max-width: 100%; overflow-x: auto; } & > table { display: block; max-width: 100%; overflow-x: auto; } & .wp-block-embed iframe { height: auto; max-width: 100%; width: 100%; } & .wp-embed-aspect-16-9 iframe { aspect-ratio: 16 / 9; } & .wp-embed-aspect-4-3 iframe { aspect-ratio: 4 / 3; } & .wp-caption { max-width: 100%; }"
      }
    }
  }
}
