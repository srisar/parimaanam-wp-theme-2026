{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "templateParts": [
    {
      "area": "header",
      "name": "header",
      "title": "Header"
    },
    {
      "area": "footer",
      "name": "footer",
      "title": "Footer"
    }
  ],
  "settings": {
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "color": "#f7f6f1",
          "name": "Paper",
          "slug": "paper"
        },
        {
          "color": "#ffffff",
          "name": "Surface",
          "slug": "surface"
        },
        {
          "color": "#14242d",
          "name": "Ink",
          "slug": "ink"
        },
        {
          "color": "#5a6870",
          "name": "Muted",
          "slug": "muted"
        },
        {
          "color": "#0b6f75",
          "name": "Observatory",
          "slug": "observatory"
        },
        {
          "color": "#07545a",
          "name": "Observatory Dark",
          "slug": "observatory-dark"
        },
        {
          "color": "#d9e1e2",
          "name": "Line",
          "slug": "line"
        },
        {
          "color": "#dceff0",
          "name": "Highlight",
          "slug": "highlight"
        }
      ]
    },
    "layout": {
      "contentSize": "44rem",
      "wideSize": "80rem"
    },
    "spacing": {
      "blockGap": true,
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "margin": true,
      "padding": true,
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      },
      "units": [
        "rem",
        "%"
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Google Sans\", system-ui, sans-serif",
          "name": "Primary",
          "slug": "primary",
          "fontFace": [
            {
              "fontDisplay": "swap",
              "fontFamily": "Google Sans",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "src": [
                "file:./assets/fonts/google-sans/GoogleSans-Tamil-Variable.woff2"
              ],
              "unicodeRange": "U+0964-0965, U+0B82-0BFA, U+200C-200D, U+20B9, U+25CC"
            },
            {
              "fontDisplay": "swap",
              "fontFamily": "Google Sans",
              "fontStretch": "normal",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "src": [
                "file:./assets/fonts/google-sans/GoogleSans-Latin-Variable.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "fluid": false,
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "fluid": {
            "min": "1.0625rem",
            "max": "1.125rem"
          },
          "name": "Medium",
          "size": "1.125rem",
          "slug": "medium"
        },
        {
          "fluid": {
            "min": "1.25rem",
            "max": "1.5rem"
          },
          "name": "Large",
          "size": "1.5rem",
          "slug": "large"
        },
        {
          "fluid": {
            "min": "1.75rem",
            "max": "2.25rem"
          },
          "name": "Extra Large",
          "size": "2.25rem",
          "slug": "x-large"
        },
        {
          "fluid": {
            "min": "2.25rem",
            "max": "3.25rem"
          },
          "name": "Extra Extra Large",
          "size": "3.25rem",
          "slug": "xx-large"
        }
      ],
      "fontStyle": false,
      "fontWeight": true,
      "letterSpacing": false,
      "lineHeight": false,
      "textColumns": false,
      "textTransform": false,
      "writingMode": false
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|40"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|primary",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.8"
    },
    "css": "::selection { background: var(--wp--preset--color--highlight); color: var(--wp--preset--color--ink); } :where(.wp-site-blocks *:focus-visible) { outline: 3px solid var(--wp--preset--color--observatory); outline-offset: 3px; } .home-magazine .wp-block-post-template { display: grid; gap: var(--wp--preset--spacing--60); grid-template-columns: minmax(0, 1fr); } .home-magazine .wp-block-post { margin: 0; min-width: 0; } .home-magazine .wp-block-post:not(:first-child) .wp-block-post-excerpt { display: none; } @media (min-width: 48rem) { .home-magazine .wp-block-post-template { grid-template-columns: repeat(2, minmax(0, 1fr)); } .home-magazine .wp-block-post:first-child { grid-column: 1 / -1; } .home-magazine .wp-block-post:first-child .wp-block-post-title { font-size: var(--wp--preset--font-size--x-large) !important; } } @media (min-width: 64rem) { .home-magazine .wp-block-post-template { grid-template-columns: repeat(12, minmax(0, 1fr)); } .home-magazine .wp-block-post:first-child { grid-column: 1 / 9; } .home-magazine .wp-block-post:nth-child(2) { grid-column: 9 / 13; } .home-magazine .wp-block-post:nth-child(n+3) { grid-column: span 4; } }",
    "elements": {
      "button": {
        "border": {
          "radius": "0.25rem",
          "style": "solid",
          "width": "1px"
        },
        "color": {
          "background": "var:preset|color|observatory",
          "text": "var:preset|color|surface"
        },
        "spacing": {
          "padding": {
            "bottom": "0.75rem",
            "left": "1rem",
            "right": "1rem",
            "top": "0.75rem"
          }
        },
        "typography": {
          "fontWeight": "700",
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|observatory-dark",
            "text": "var:preset|color|surface"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "lineHeight": "1.5"
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|ink"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|primary",
          "fontWeight": "700",
          "lineHeight": "1.35"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|observatory"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|observatory-dark"
          }
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|large"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      }
    },
    "blocks": {
      "core/post-comments-form": {
        "css": "& textarea, & input:not([type=submit]):not([type=checkbox]) { background: var(--wp--preset--color--surface); border: 1px solid var(--wp--preset--color--line); border-radius: 0.25rem; color: var(--wp--preset--color--ink); font-family: inherit; padding: 0.75rem; }"
      },
      "core/post-content": {
        "css": "& pre { max-width: 100%; overflow-x: auto; } & > table { display: block; max-width: 100%; overflow-x: auto; } & .wp-block-embed iframe { height: auto; max-width: 100%; width: 100%; } & .wp-embed-aspect-16-9 iframe { aspect-ratio: 16 / 9; } & .wp-embed-aspect-4-3 iframe { aspect-ratio: 4 / 3; } & .wp-caption { max-width: 100%; }"
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|muted"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var:preset|color|observatory"
              },
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "css": "& { overflow-wrap: anywhere; }",
        "typography": {
          "lineHeight": "1.7"
        }
      },
      "core/post-featured-image": {
        "border": {
          "radius": "0.5rem"
        },
        "css": "& { overflow: hidden; }"
      },
      "core/post-terms": {
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|observatory"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var:preset|color|observatory"
              }
            }
          }
        }
      },
      "core/quote": {
        "border": {
          "color": "var:preset|color|observatory",
          "radius": "0.25rem",
          "style": "solid",
          "width": "0 0 0 3px"
        },
        "color": {
          "background": "var:preset|color|surface"
        },
        "spacing": {
          "padding": {
            "bottom": "var:preset|spacing|40",
            "left": "var:preset|spacing|50",
            "right": "var:preset|spacing|50",
            "top": "var:preset|spacing|40"
          }
        }
      },
      "core/search": {
        "css": "& .wp-block-search__input { background: var(--wp--preset--color--surface); border: 1px solid var(--wp--preset--color--line); border-radius: 0.25rem; color: var(--wp--preset--color--ink); font-family: inherit; padding: 0.75rem; }",
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/separator": {
        "border": {
          "color": "var:preset|color|line",
          "style": "solid",
          "width": "0 0 1px 0"
        },
        "color": {
          "text": "var:preset|color|line"
        }
      },
      "core/site-title": {
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|ink"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        },
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      }
    }
  }
}
